---
import type { Project } from '../data/projects';
interface Props { p: Project; big?: boolean; }
const { p, big = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const initials = p.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
const stack = p.stack.slice(0, big ? 6 : 4);
---
<li class="card" data-cat={p.category} data-q={`${p.name} ${p.tagline} ${p.stack.join(' ')}`.toLowerCase()}>
  <button type="button" data-slug={p.slug} class="open group flex h-full w-full flex-col overflow-hidden rounded-xl border border-line bg-panel text-left transition duration-200 hover:-translate-y-0.5 hover:border-accent/60 hover:bg-panel2">
    {big && (
      p.image
        ? <img src={`${base}/projects/${p.image}`} alt="" loading="lazy" class="aspect-[16/8] w-full object-cover" />
        : <div class="flex aspect-[16/8] items-center justify-center bg-gradient-to-br from-panel2 to-bg font-mono text-5xl text-accent/60 transition group-hover:text-accent" aria-hidden="true">{initials}</div>
    )}
    <div class="flex flex-1 flex-col p-5">
      <p class="font-mono text-xs text-accent/80">{p.category}</p>
      <h3 class="mt-1 text-lg font-semibold">{p.name}</h3>
      <p class="mt-1 text-sm text-mute">{p.tagline}</p>
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-4">
        {stack.map((s) => <li class="rounded bg-bg px-2 py-0.5 font-mono text-[11px] text-mute">{s}</li>)}
        {p.stack.length > stack.length && <li class="px-1 py-0.5 font-mono text-[11px] text-mute/70">+{p.stack.length - stack.length}</li>}
      </ul>
    </div>
  </button>
</li>
