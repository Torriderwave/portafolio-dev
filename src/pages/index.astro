---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { projects, profile } from '../data/projects';

const demos = projects.filter((p) => p.shots?.length).sort((a, b) => Number(b.device === 'browser') - Number(a.device === 'browser'));
const others = projects.filter((p) => !p.shots?.length);
const freq = new Map<string, number>();
projects.forEach((p) => p.stack.forEach((s) => freq.set(s, (freq.get(s) ?? 0) + 1)));
const topTech = [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12).map(([s]) => s);
const categories = Array.from(new Set(others.map((p) => p.category)));
---
<Base title={`${profile.name} · ${profile.role}`} description={profile.bio}>
  <header class="sticky top-0 z-30 border-b border-line/70 bg-bg/80 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3 text-sm">
      <a href="#top" class="font-semibold tracking-tight">{profile.name}<span class="text-accent">.dev</span></a>
      <div class="flex items-center gap-5 text-mute">
        <a class="hidden hover:text-fg sm:block" href="#demos">Demos</a>
        <a class="hidden hover:text-fg sm:block" href="#sistemas">Más sistemas</a>
        <a class="hover:text-fg" href={profile.motion}>Motion &amp; diseño ↗</a>
        <a class="rounded-full bg-fg px-4 py-1.5 font-medium text-bg hover:bg-accent" href="#contacto">Contacto</a>
      </div>
    </nav>
  </header>

  <main id="top" class="overflow-x-clip">
    <section class="relative overflow-hidden">
      <div class="glow pointer-events-none absolute inset-x-0 top-0 h-[520px]" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-5 pb-10 pt-20 sm:pt-28">
        <p class="fade-up inline-flex items-center gap-2 rounded-full border border-line bg-panel/80 px-3 py-1 text-xs text-mute">
          <span class="live h-2 w-2 rounded-full bg-live"></span>{profile.availability}
        </p>
        <h1 class="fade-up mt-6 max-w-4xl text-4xl font-semibold leading-[1.04] tracking-tight sm:text-6xl lg:text-7xl" style="animation-delay:.08s">
          Aplicaciones que la gente <span class="text-accent">usa de verdad.</span>
        </h1>
        <p class="fade-up mt-6 max-w-2xl text-lg text-mute" style="animation-delay:.16s">{profile.bio} Abajo puedes ver cómo se ven, con capturas reales.</p>
        <div class="fade-up mt-8 flex flex-wrap gap-3 text-sm" style="animation-delay:.24s">
          <a href="#demos" class="rounded-full bg-fg px-5 py-2.5 font-medium text-bg transition hover:bg-accent">Ver las apps ↓</a>
          <a href="#contacto" class="rounded-full border border-line px-5 py-2.5 transition hover:border-fg">Hablemos</a>
        </div>
      </div>
    </section>

    <section id="demos" class="scroll-mt-16">
      {demos.map((p, i) => (
        <article class="border-t border-line">
          <div class:list={['mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:gap-14', i % 2 && 'lg:[&>div:first-child]:order-2']}>
            <div>
              <p class="font-mono text-xs text-accent">0{i + 1} · {p.category}</p>
              <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{p.name}</h2>
              <p class="mt-3 text-lg text-fg/90">{p.tagline}</p>
              <p class="mt-4 text-mute">{p.description}</p>
              {p.note && <p class="mt-4 border-l-2 border-accent pl-4 text-sm text-fg/80">{p.note}</p>}
              <ul class="mt-5 space-y-2 text-sm text-mute">
                {p.highlights.map((h) => <li class="flex gap-2"><span class="text-accent">▸</span>{h}</li>)}
              </ul>
              <ul class="mt-6 flex flex-wrap gap-1.5">
                {p.stack.map((s) => <li class="rounded-md border border-line bg-panel px-2 py-0.5 font-mono text-xs text-mute">{s}</li>)}
              </ul>
              {(p.repo || p.demo) && (
                <div class="mt-6 flex gap-5 text-sm">
                  {p.repo && <a class="text-accent hover:underline" href={p.repo}>Ver código ↗</a>}
                  {p.demo && <a class="text-accent hover:underline" href={p.demo}>Probar demo ↗</a>}
                </div>
              )}
            </div>
            <div class="relative">
              <div class="glow pointer-events-none absolute -inset-8" aria-hidden="true"></div>
              <div class="relative"><Frame id={p.slug} title={p.name} shots={p.shots!} device={p.device} /></div>
              {p.device === 'browser' && <p class="mt-3 text-center text-xs text-mute">Capturas reales de la app con datos de demostración.</p>}
              {p.device === 'phone' && <p class="mt-5 text-center text-xs text-mute">Captura real de la app, con datos de demostración.</p>}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section id="sistemas" class="scroll-mt-16 border-t border-line bg-bg2">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="text-3xl font-semibold tracking-tight">Más sistemas</h2>
        <p class="mt-2 max-w-2xl text-mute">Proyectos donde el valor está en la arquitectura más que en la pantalla. Cada ficha muestra cómo está armado.</p>

        <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Filtrar por área">
          {['Todos', ...categories].map((c, i) => (
            <button type="button" data-filter={c} aria-pressed={i === 0} class="filter rounded-full border border-line px-3 py-1 text-sm text-mute transition hover:text-fg aria-pressed:border-accent aria-pressed:text-accent">{c}</button>
          ))}
        </div>

        <ul class="mt-8 grid gap-5 md:grid-cols-2">
          {others.map((p) => (
            <li class="sys" data-cat={p.category}>
              <article class="flex h-full flex-col overflow-hidden rounded-xl border border-line bg-panel">
                <div class="border-b border-line bg-bg px-4 py-2 font-mono text-xs text-mute">
                  <span class="text-live">●</span> ~/{p.slug}
                </div>
                <div class="min-h-[10.5rem] bg-bg p-4 font-mono text-[12.5px] leading-relaxed text-mute">
                  <p class="text-fg/60">$ stack --list</p>
                  <p class="mt-1 text-accent">{p.stack.join(' · ')}</p>
                  <p class="mt-3 text-fg/60">$ cat highlights</p>
                  {p.highlights.map((h) => <p class="mt-1 flex gap-2"><span class="text-live">✓</span><span>{h}</span></p>)}
                </div>
                <div class="flex flex-1 flex-col p-5">
                  <p class="font-mono text-xs text-accent">{p.category}</p>
                  <h3 class="mt-1 text-xl font-semibold">{p.name}</h3>
                  <p class="mt-1 text-fg/90">{p.tagline}</p>
                  <p class="mt-3 text-sm text-mute">{p.description}</p>
                  {(p.repo || p.demo) && (
                    <div class="mt-4 flex gap-5 pt-1 text-sm">
                      {p.repo && <a class="text-accent hover:underline" href={p.repo}>Código ↗</a>}
                      {p.demo && <a class="text-accent hover:underline" href={p.demo}>Demo ↗</a>}
                    </div>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="border-t border-line">
      <div class="mx-auto max-w-6xl px-5 py-16">
        <h2 class="text-3xl font-semibold tracking-tight">Qué puedo hacer por tu equipo o tu negocio</h2>
        <ul class="mt-8 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
          {profile.offers.map((o) => (
            <li class="bg-bg p-6"><h3 class="font-semibold">{o.t}</h3><p class="mt-2 text-sm text-mute">{o.d}</p></li>
          ))}
        </ul>
        <ul class="mt-8 flex flex-wrap gap-2" aria-label="Tecnologías">
          {topTech.map((t) => <li class="rounded-full border border-line bg-panel px-3 py-1 font-mono text-xs text-mute">{t}</li>)}
        </ul>
      </div>
    </section>

    <section id="contacto" class="scroll-mt-16 border-t border-line">
      <div class="relative mx-auto max-w-6xl overflow-hidden px-5 py-24">
        <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
        <h2 class="relative max-w-3xl text-4xl font-semibold leading-tight tracking-tight sm:text-6xl">¿Buscas desarrollador o tienes un proyecto? <span class="text-accent">Hablemos.</span></h2>
        <div class="relative mt-8 flex flex-wrap gap-3 text-sm">
          {profile.email && <a class="rounded-full bg-fg px-5 py-2.5 font-medium text-bg hover:bg-accent" href={`mailto:${profile.email}`}>{profile.email}</a>}
          <a class="rounded-full border border-line px-5 py-2.5 hover:border-fg" href={profile.github}>GitHub ↗</a>
          <a class="rounded-full border border-line px-5 py-2.5 hover:border-fg" href={profile.motion}>Portafolio de motion y diseño ↗</a>
        </div>
      </div>
    </section>
  </main>
  <footer class="border-t border-line py-6 text-center text-xs text-mute">© {new Date().getFullYear()} {profile.name}</footer>

  <script>
    document.querySelectorAll<HTMLElement>('[data-frame]').forEach((f) => {
      const imgs = f.querySelectorAll<HTMLElement>('[data-shot]');
      const tabs = f.querySelectorAll<HTMLButtonElement>('[data-tab]');
      let i = 0, timer: number | undefined;
      const go = (n: number) => {
        i = n;
        imgs.forEach((im, k) => { im.style.opacity = k === n ? '1' : '0'; });
        tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === n)));
      };
      tabs.forEach((t, k) => t.addEventListener('click', () => { clearInterval(timer); go(k); }));
      if (tabs.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches)
        timer = window.setInterval(() => go((i + 1) % imgs.length), 4500);
    });
    const fb = document.querySelectorAll<HTMLButtonElement>('.filter');
    const sys = document.querySelectorAll<HTMLElement>('.sys');
    fb.forEach((b) => b.addEventListener('click', () => {
      fb.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      sys.forEach((s) => { s.hidden = b.dataset.filter !== 'Todos' && s.dataset.cat !== b.dataset.filter; });
    }));
  </script>
</Base>
