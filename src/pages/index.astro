---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import { projects, profile } from '../data/projects';
import { CONTACT_URL, CONTACT_LABEL } from '../data/contact';

const demos = projects.filter((p) => p.shots?.length).sort((a, b) => Number(b.device === 'browser') - Number(a.device === 'browser'));
const others = projects
  .filter((p) => !p.shots?.length)
  .sort((a, b) => Number(!!b.featured) - Number(!!a.featured)); // destacados primero (orden estable)
const freq = new Map<string, number>();
projects.forEach((p) => p.stack.forEach((s) => freq.set(s, (freq.get(s) ?? 0) + 1)));
const topTech = [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 16).map(([s]) => s);
const categories = Array.from(new Set(others.map((p) => p.category)));
const countBy = (c: string) => others.filter((p) => p.category === c).length;

const catColor: Record<string, string> = {
  'Seguridad / Tiempo real': '#f87171',
  'Web3 / Solana': '#c084fc',
  'Negocios / POS': '#fbbf24',
  'Plataformas': '#8b9bff',
  'Herramientas': '#5eead4',
  'Infraestructura': '#7dd3fc',
};

const lead = demos[0];
const second = demos[1];
const stats = [
  { n: projects.length, l: 'sistemas construidos' },
  { n: demos.length, l: 'demos con capturas reales' },
  { n: freq.size, l: 'tecnologías en uso' },
];
const nav = [
  { href: '#demos', label: 'Demos' },
  { href: '#sistemas', label: 'Más sistemas' },
  { href: '#servicios', label: 'Servicios' },
];
const contactHref = profile.email ? `mailto:${profile.email}` : CONTACT_URL;
const contactExternal = !profile.email;
const contactText = profile.email ? profile.email : `Escríbeme por ${CONTACT_LABEL}`;
const title = `${profile.name} · ${profile.role}`;
---
<Base title={title} description={profile.bio} image="og.png" imageAlt={lead ? `${lead.name}: ${lead.shots![0].label}` : ''}>
  <header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-bg/60 backdrop-blur-xl transition-colors duration-300">
    <nav class="wrap flex flex-wrap items-center justify-between gap-x-4 py-1.5" aria-label="Principal" id="site-nav">
      <a href="#top" class="inline-flex min-h-11 items-center gap-2 font-semibold tracking-tight">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} alt="" width="24" height="24" class="h-6 w-6" />
        <span>{profile.name}<span class="text-accent">.dev</span></span>
      </a>
      <button type="button" class="menu-btn btn btn-ghost !px-4" aria-expanded="false" aria-controls="nav-panel" id="menu-btn">
        <span id="menu-label">Menú</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path class="m-open" d="M2 5h12M2 11h12"/><path class="m-close hidden" d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
      </button>
      <div id="nav-panel" class="nav-panel w-full flex-col gap-1 pb-3 pt-2 md:w-auto md:flex-row md:items-center md:gap-1 md:pb-0 md:pt-0">
        {nav.map((n) => <a class="navlink" href={n.href}>{n.label}</a>)}
        <a class="navlink" href={profile.motion} rel="noopener">Motion &amp; diseño <span aria-hidden="true">↗</span><span class="sr-only"> (abre otro sitio)</span></a>
        <a class="btn btn-primary mt-2 md:ml-2 md:mt-0" href="#contacto">Contacto</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <!-- ───────────── Hero ───────────── -->
    <section id="top" class="clip" aria-labelledby="hero-title">
      <div class="glow" style="background: radial-gradient(55% 55% at 50% 0%, rgb(139 155 255 / .26), transparent 70%)" aria-hidden="true"></div>
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="wrap pb-section pt-[clamp(2.5rem,1.5rem+5vw,6rem)]">
        <p class="fade-up inline-flex items-center gap-2 rounded-2xl border border-line2 bg-panel/70 py-1.5 pl-3 pr-4 text-micro backdrop-blur sm:rounded-full sm:text-small text-mute backdrop-blur" style="--d:0">
          <span class="live h-2 w-2 rounded-full bg-live" aria-hidden="true"></span>{profile.availability}
        </p>
        <h1 id="hero-title" class="fade-up mt-7 max-w-[22ch] text-display font-semibold lg:leading-[1.03]" style="--d:90">
          Aplicaciones que la gente <span class="bg-gradient-to-r from-accent via-[#b6c0ff] to-live bg-clip-text text-transparent">usa de verdad.</span>
        </h1>
        <p class="fade-up mt-7 max-w-[45ch] text-lead text-mute" style="--d:180">{profile.bio} Abajo puedes ver cómo se ven, con capturas reales.</p>
        <div class="fade-up mt-9 flex flex-wrap gap-3" style="--d:270">
          <a href={contactHref} class="btn btn-primary" target={contactExternal ? '_blank' : undefined} rel={contactExternal ? 'noopener noreferrer' : undefined}>Hablemos{contactExternal && <span class="sr-only"> (abre LinkedIn en otra pestaña)</span>} <span aria-hidden="true">{contactExternal ? '↗' : '→'}</span></a>
          <a href="#demos" class="btn btn-ghost">Ver las apps <span aria-hidden="true">↓</span></a>
        </div>

        <dl class="fade-up mt-12 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6 sm:gap-8" style="--d:360">
          {stats.map((s) => (
            <div class="flex flex-col-reverse justify-end gap-2">
              <dt class="text-micro text-mute sm:text-small">{s.l}</dt>
              <dd class="text-sub font-semibold tabular-nums leading-none">{s.n}</dd>
            </div>
          ))}
        </dl>

        {lead && (
          <div class="fade-up relative mt-[clamp(2.5rem,1.5rem+3vw,4.5rem)]" style="--d:450" aria-hidden="true">
            <div class="relative lg:w-[88%]">
              <Frame id="hero-lead" title={lead.name} shots={[lead.shots![0]]} device="browser" priority sizes="(min-width: 1280px) 1000px, 100vw" />
            </div>
            {second && (
              <div class="float absolute -bottom-10 right-0 hidden w-[48%] lg:block">
                <Frame id="hero-second" title={second.name} shots={[second.shots![0]]} device="browser" sizes="480px" />
              </div>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- ───────────── Demos ───────────── -->
    <section id="demos" aria-labelledby="demos-title">
      <div class="wrap pb-block pt-section">
        <div data-reveal class="max-w-3xl">
          <p class="eyebrow">Demos · capturas reales</p>
          <h2 id="demos-title" class="mt-4 text-title font-semibold">Dos sistemas, de punta a punta.</h2>
          <p class="measure mt-5 text-lead text-mute">Cada demo muestra pantallas reales de la aplicación con datos de demostración. Cambia de pantalla con las pestañas.</p>
        </div>
      </div>

      {demos.map((p, i) => (
        <article class="clip border-t border-line" aria-labelledby={`${p.slug}-title`}>
          <div class="glow" style={`background: radial-gradient(45% 45% at ${i % 2 ? '15%' : '85%'} 40%, rgb(139 155 255 / .12), transparent 70%)`} aria-hidden="true"></div>
          <div class:list={['wrap grid items-start gap-10 py-[clamp(3.5rem,2.5rem+4vw,6rem)] lg:gap-14', i % 2 ? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(28rem,1fr)] lg:[&>div:first-child]:order-2' : 'lg:grid-cols-[minmax(28rem,1fr)_minmax(0,1.15fr)]']}>
            <div data-reveal class="lg:sticky lg:top-24">
              <p class="eyebrow"><span>{String(i + 1).padStart(2, '0')}</span> · {p.category}</p>
              <h3 id={`${p.slug}-title`} class="mt-4 text-sub font-semibold">{p.name}</h3>
              <p class="mt-3 text-lead text-fg/90">{p.tagline}</p>
              <p class="measure mt-4 text-mute">{p.description}</p>
              {p.note && (
                <aside class="mt-6 rounded-xl border border-line bg-panel/70 p-4" aria-label="Enfoque">
                  <p class="eyebrow !text-live">Cómo lo pensé</p>
                  <p class="mt-2 text-small text-fg/85">{p.note}</p>
                </aside>
              )}
              <ul class="mt-6 space-y-2.5 text-small text-fg/85" aria-label={`Puntos clave de ${p.name}`}>
                {p.highlights.map((h) => (
                  <li class="flex gap-3"><svg class="mt-[.3rem] h-4 w-4 shrink-0 text-live" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg><span>{h}</span></li>
                ))}
              </ul>
              <ul class="mt-6 flex flex-wrap gap-1.5" aria-label={`Stack de ${p.name}`}>
                {p.stack.map((s) => <li class="chip">{s}</li>)}
              </ul>
              {(p.repo || p.demo) && (
                <div class="mt-4 flex flex-wrap gap-x-6">
                  {p.repo && <a class="link" href={p.repo} rel="noopener">Ver código <span aria-hidden="true">↗</span></a>}
                  {p.demo && <a class="link" href={p.demo} rel="noopener">Probar demo <span aria-hidden="true">↗</span></a>}
                </div>
              )}
            </div>
            <div data-reveal class="min-w-0" style="--d:120">
              <Frame id={p.slug} title={p.name} shots={p.shots!} device={p.device} />
              <p class="mt-4 text-center text-micro text-mute">{p.device === 'phone' ? 'Captura real de la app, con datos de demostración.' : 'Capturas reales de la app con datos de demostración.'}</p>
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- ───────────── Más sistemas ───────────── -->
    <section id="sistemas" class="mt-section border-t border-line bg-bg2" aria-labelledby="sistemas-title">
      <div class="wrap py-section">
        <div data-reveal class="max-w-3xl">
          <p class="eyebrow">Más sistemas</p>
          <h2 id="sistemas-title" class="mt-4 text-title font-semibold">Donde el valor está en la arquitectura.</h2>
          <p class="measure mt-5 text-lead text-mute">Proyectos donde pesa más cómo está armado que la pantalla. Cada ficha muestra el stack y las decisiones clave.</p>
        </div>

        <div data-reveal class="mt-10 flex flex-wrap gap-2" role="group" aria-label="Filtrar por área">
          <button type="button" class="filter" data-filter="Todos" aria-pressed="true">Todos<span class="count">{others.length}</span></button>
          {categories.map((c) => (
            <button type="button" class="filter" data-filter={c} aria-pressed="false">{c}<span class="count">{countBy(c)}</span></button>
          ))}
        </div>
        <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>

        <ul class="mt-8 grid gap-4 md:grid-cols-2 md:gap-5" id="sys-list">
          {others.map((p, i) => (
            <li class="sys" data-cat={p.category} data-reveal style={`--d:${(i % 2) * 60}`}>
              <article class="card" data-featured={p.featured ? 'true' : 'false'}>
                <div class="flex flex-1 flex-col gap-4 p-5">
                  <div class="flex items-center justify-between gap-3">
                    <p class="flex items-center gap-2 font-mono text-micro text-mute">
                      <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${catColor[p.category] ?? '#8b9bff'}`} aria-hidden="true"></span>{p.category}
                    </p>
                    {p.featured && <span class="rounded-full border border-accent/40 bg-accent/10 px-2.5 py-0.5 text-micro font-medium text-accent">Destacado</span>}
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold tracking-tight">{p.name}</h3>
                    <p class="mt-1.5 text-fg/90">{p.tagline}</p>
                    <p class="mt-3 text-small text-mute">{p.description}</p>
                  </div>
                  <ul class="flex flex-wrap gap-1.5" aria-label={`Stack de ${p.name}`}>
                    {p.stack.map((s) => <li class="chip">{s}</li>)}
                  </ul>
                  <details class="more mt-auto border-t border-line">
                    <summary>Ver arquitectura <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6"/></svg></summary>
                    <ul class="space-y-2 pb-2 pt-1 text-small text-fg/85">
                      {p.highlights.map((h) => (
                        <li class="flex gap-2.5"><svg class="mt-[.28rem] h-4 w-4 shrink-0 text-live" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3L12.5 4.5"/></svg><span>{h}</span></li>
                      ))}
                    </ul>
                  </details>
                  {(p.repo || p.demo) && (
                    <div class="-mt-2 flex gap-6">
                      {p.repo && <a class="link text-small" href={p.repo} rel="noopener">Código <span aria-hidden="true">↗</span><span class="sr-only"> de {p.name}</span></a>}
                      {p.demo && <a class="link text-small" href={p.demo} rel="noopener">Demo <span aria-hidden="true">↗</span><span class="sr-only"> de {p.name}</span></a>}
                    </div>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────────── Servicios ───────────── -->
    <section id="servicios" class="border-t border-line" aria-labelledby="servicios-title">
      <div class="wrap py-section">
        <div data-reveal class="max-w-3xl">
          <p class="eyebrow">Servicios</p>
          <h2 id="servicios-title" class="mt-4 text-title font-semibold">Qué puedo hacer por tu equipo o tu negocio.</h2>
        </div>
        <ul class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
          {profile.offers.map((o, i) => (
            <li class="group bg-bg p-7 transition-colors hover:bg-panel" data-reveal style={`--d:${i * 80}`}>
              <p class="font-mono text-micro text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-6 text-lg font-semibold tracking-tight">{o.t}</h3>
              <p class="mt-2 text-small text-mute">{o.d}</p>
            </li>
          ))}
        </ul>
        <div data-reveal class="mt-12">
          <h3 class="text-small font-medium text-mute">Tecnologías con las que trabajo</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {topTech.map((t) => <li class="chip !rounded-full !px-3 !py-1">{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ───────────── Contacto ───────────── -->
    <section id="contacto" class="border-t border-line" aria-labelledby="contacto-title">
      <div class="wrap py-section">
        <div data-reveal class="clip rounded-3xl border border-line2 bg-panel/60 px-[clamp(1.5rem,1rem+4vw,5rem)] py-[clamp(3rem,2rem+5vw,6rem)]">
          <div class="glow" style="background: radial-gradient(60% 80% at 50% 110%, rgb(139 155 255 / .3), transparent 70%)" aria-hidden="true"></div>
          <div class="grid-bg" aria-hidden="true"></div>
          <div class="grid items-end gap-10 md:grid-cols-12">
            <div class="md:col-span-7">
              <p class="eyebrow">Contacto</p>
              <h2 id="contacto-title" class="mt-4 text-title font-semibold">¿Buscas desarrollador o tienes un proyecto? <span class="text-accent">Hablemos.</span></h2>
              <p class="measure mt-5 text-lead text-mute">{profile.availability}.</p>
            </div>
            <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap md:col-span-5 md:flex-col md:items-stretch">
              <a class="btn btn-primary !min-h-12 !text-base" href={contactHref} target={contactExternal ? '_blank' : undefined} rel={contactExternal ? 'noopener noreferrer' : undefined}>{contactText}{contactExternal && <span class="sr-only"> (abre en otra pestaña)</span>} <span aria-hidden="true">{contactExternal ? '↗' : '→'}</span></a>
              <a class="btn btn-ghost" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a>
              <a class="btn btn-ghost" href={profile.motion} rel="noopener">Portafolio de motion y diseño <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line bg-bg2">
    <div class="wrap flex flex-col gap-8 py-10 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="font-semibold tracking-tight">{profile.name}<span class="text-accent">.dev</span></p>
        <p class="mt-2 max-w-xs text-small text-mute">{profile.role}. {profile.availability}.</p>
      </div>
      <nav aria-label="Pie de página">
        <ul class="flex flex-wrap gap-x-2 gap-y-1 text-small">
          {nav.map((n) => <li><a class="navlink" href={n.href}>{n.label}</a></li>)}
          <li><a class="navlink" href="#contacto">Contacto</a></li>
          <li><a class="navlink" href={contactHref} target={contactExternal ? '_blank' : undefined} rel={contactExternal ? 'noopener noreferrer' : undefined}>{profile.email ? profile.email : CONTACT_LABEL} <span aria-hidden="true">↗</span></a></li>
          <li><a class="navlink" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a></li>
          <li><a class="navlink" href={profile.motion} rel="noopener">Portafolio de motion y diseño <span aria-hidden="true">↗</span></a></li>
        </ul>
      </nav>
    </div>
    <div class="border-t border-line">
      <div class="wrap flex items-center justify-between py-4 text-micro text-mute">
        <p>© {new Date().getFullYear()} {profile.name}</p>
        <a class="link !min-h-11" href="#top">Volver arriba <span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </footer>

  <script>
    // Menú móvil
    const header = document.getElementById('site-header')!;
    const nav = document.getElementById('site-nav')!;
    const btn = document.getElementById('menu-btn') as HTMLButtonElement;
    const label = document.getElementById('menu-label')!;
    const setMenu = (open: boolean) => {
      nav.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Cerrar' : 'Menú';
      btn.querySelector('.m-open')!.classList.toggle('hidden', open);
      btn.querySelector('.m-close')!.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
    nav.querySelectorAll('#nav-panel a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setMenu(false); btn.focus(); } });

    // Cabecera con borde al hacer scroll
    const onScroll = () => header.classList.toggle('header-scrolled', window.scrollY > 8);
    onScroll(); addEventListener('scroll', onScroll, { passive: true });

    // Sección activa en la navegación
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('#nav-panel a[href^="#"]').forEach((a) => links.set(a.getAttribute('href')!.slice(1), a));
    if ('IntersectionObserver' in window) {
      const spy = new IntersectionObserver((es) => es.forEach((e) => {
        const a = links.get(e.target.id);
        if (!a) return;
        if (e.isIntersecting) { links.forEach((l) => l.removeAttribute('aria-current')); a.setAttribute('aria-current', 'true'); }
        else a.removeAttribute('aria-current');
      }), { rootMargin: '-45% 0px -50% 0px' });
      links.forEach((_, id) => { const s = document.getElementById(id); if (s) spy.observe(s); });
    }

    // Filtro de sistemas
    const fb = document.querySelectorAll<HTMLButtonElement>('.filter');
    const sys = document.querySelectorAll<HTMLElement>('.sys');
    const status = document.getElementById('filter-status')!;
    fb.forEach((b) => b.addEventListener('click', () => {
      fb.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      sys.forEach((s) => {
        const show = b.dataset.filter === 'Todos' || s.dataset.cat === b.dataset.filter;
        s.hidden = !show;
        if (show) { n++; s.classList.add('is-in'); }
      });
      status.textContent = `Mostrando ${n} ${n === 1 ? 'sistema' : 'sistemas'}${b.dataset.filter === 'Todos' ? '' : ` en ${b.dataset.filter}`}`;
    }));
  </script>
</Base>
