---
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Arch from '../components/Arch.astro';
import { projects, profile } from '../data/projects';
import ContactLink from '../components/ContactLink.astro';
import { contactActions, action } from '../data/contact';

const demos = projects.filter((p) => p.shots?.length).sort((a, b) => Number(b.device === 'browser') - Number(a.device === 'browser'));
const others = projects
  .filter((p) => !p.shots?.length)
  .sort((a, b) => Number(!!b.featured) - Number(!!a.featured)); // destacados primero (orden estable)
const freq = new Map<string, number>();
projects.forEach((p) => p.stack.forEach((s) => freq.set(s, (freq.get(s) ?? 0) + 1)));
const topTech = [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 16).map(([s]) => s);
const categories = Array.from(new Set(others.map((p) => p.category)));
const countBy = (c: string) => others.filter((p) => p.category === c).length;

const catColor: Record<string, string> = {
  'Seguridad / Tiempo real': '#f87171',
  'Web3 / Solana': '#c084fc',
  'Negocios / POS': '#fbbf24',
  'Plataformas': '#8b9bff',
  'Herramientas': '#5eead4',
  'Infraestructura': '#7dd3fc',
};

const lead = demos[0];
const second = demos[1];
const stats = [
  { n: projects.length, l: 'sistemas' },
  { n: demos.length, l: 'demos' },
  { n: freq.size, l: 'tecnologías' },
];
const nav = [
  { href: '#demos', label: 'Demos' },
  { href: '#sistemas', label: 'Sistemas' },
  { href: '#servicios', label: 'Servicios' },
];
const wa = action('whatsapp')!;
const call = action('llamar')!;
const secondary = contactActions.filter((a) => a.id !== 'whatsapp');
const title = `${profile.name} · ${profile.role}`;
---
<Base title={title} description={profile.bio} image="og.png" imageAlt={lead ? `${lead.name}: ${lead.shots![0].label}` : ''}>
  <header id="site-header" class="sticky top-0 z-40 border-b border-transparent bg-bg/85 backdrop-blur-xl transition-colors duration-300">
    <nav class="wrap flex flex-wrap items-center justify-between gap-x-4 py-1" aria-label="Principal" id="site-nav">
      <a href="#top" class="inline-flex min-h-11 items-center gap-2 font-semibold tracking-tight">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} alt="" width="24" height="24" class="h-6 w-6" />
        <span>{profile.name}<span class="text-accent">.dev</span></span>
      </a>
      <button type="button" class="menu-btn btn btn-ghost !px-4" aria-expanded="false" aria-controls="nav-panel" id="menu-btn">
        <span id="menu-label">Menú</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path class="m-open" d="M2 5h12M2 11h12"/><path class="m-close hidden" d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
      </button>
      <div id="nav-panel" class="nav-panel w-full flex-col gap-1 pb-3 pt-2 md:w-auto md:flex-row md:items-center md:gap-1 md:pb-0 md:pt-0">
        {nav.map((n) => <a class="navlink" href={n.href}>{n.label}</a>)}
        <a class="navlink" href={profile.motion} rel="noopener">Motion &amp; diseño <span aria-hidden="true">↗</span><span class="sr-only"> (abre otro sitio)</span></a>
        <a class="btn btn-primary mt-2 md:ml-2 md:mt-0" href="#contacto">Contacto</a>
      </div>
    </nav>
    <p class="narr narr-m wrap" aria-hidden="true"><span class="p">&gt;</span> <span class="out"></span><span class="c"></span></p>
    <div class="progress" id="progress" aria-hidden="true"><i></i></div>
  </header>
  <p class="narr narr-d" aria-hidden="true"><span class="p">&gt;</span> <span class="out"></span><span class="c"></span></p>

  <main id="main">
    <!-- ───────────── Hero ───────────── -->
    <section id="top" class="clip" data-narr="boot portafolio… ok" aria-labelledby="hero-title">
      <div class="glow" style="background: radial-gradient(55% 55% at 50% 0%, rgb(139 155 255 / .26), transparent 70%)" aria-hidden="true"></div>
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="wrap pb-section pt-[clamp(2.5rem,1.5rem+5vw,6rem)]">
        <p class="hp inline-flex items-center gap-2 rounded-full border border-line2 bg-panel/70 py-1.5 pl-3 pr-4 text-small text-mute backdrop-blur" style="--d:40">
          <span class="live h-2 w-2 rounded-full bg-live" aria-hidden="true"></span>{profile.availability}
        </p>
        <p class="cmd" aria-hidden="true"><span class="p">$</span> <span class="cmd-out"></span><span class="caret"></span></p>
        <h1 id="hero-title" class="relative mt-6 max-w-[22ch] text-display font-semibold lg:leading-[1.03]" aria-label="Aplicaciones que la gente usa de verdad.">
          <span class="real">Aplicaciones que la gente <span class="grad">usa de verdad.</span></span>
        </h1>
        <p class="hp mt-5 max-w-[40ch] text-lead text-mute" style="--d:680">Web, punto de venta, Solana e infraestructura.</p>
        <div id="hero-cta" class="hp mt-8 grid gap-3 sm:flex sm:flex-wrap" data-full style="--d:860">
          <ContactLink a={wa} class="btn btn-primary !min-h-12 sm:!min-h-11" />
          <a href="#demos" class="btn btn-ghost !min-h-12 sm:!min-h-11">Ver las apps <span aria-hidden="true">↓</span></a>
        </div>

        <dl class="hp mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6 sm:mt-12 sm:gap-8" data-full style="--d:1040">
          {stats.map((s) => (
            <div class="flex flex-col-reverse justify-end gap-2">
              <dt class="text-small text-mute">{s.l}</dt>
              <dd class="text-sub font-semibold tabular-nums leading-none">
                <span class="flaps" role="img" aria-label={String(s.n)}>
                  {String(s.n).split('').map((d) => <span class="fl" data-n={d}>{d}</span>)}
                </span>
              </dd>
            </div>
          ))}
        </dl>

        {lead && (
          <div class="relative mt-[clamp(2.25rem,1.5rem+3vw,4.5rem)]" aria-hidden="true">
            <div class="relative lg:w-[88%]">
              <Frame id="hero-lead" title={lead.name} shots={[lead.shots![0]]} device="browser" priority sizes="(min-width: 1280px) 1000px, 100vw" />
            </div>
            {second && (
              <div class="absolute -bottom-10 right-0 hidden w-[48%] lg:block">
                <Frame id="hero-second" title={second.name} shots={[second.shots![0]]} device="browser" sizes="480px" />
              </div>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- ───────────── Demos ───────────── -->
    <section id="demos" data-narr={`load demos… ${demos.length}`} aria-labelledby="demos-title">
      <div class="wrap pb-block pt-section">
        <div data-print class="max-w-3xl">
          <p class="eyebrow">Demos · capturas reales</p>
          <h2 id="demos-title" class="mt-3 text-title font-semibold">Dos sistemas, de punta a punta.</h2>
          <p class="measure mt-4 text-lead text-mute">Pantallas reales con datos de demostración.</p>
        </div>
      </div>

      {demos.map((p, i) => (
        <article class="clip border-t border-line" data-narr={`deploy ${p.slug}… ok`} aria-labelledby={`${p.slug}-title`}>
          <div class="glow" style={`background: radial-gradient(45% 45% at ${i % 2 ? '15%' : '85%'} 40%, rgb(139 155 255 / .12), transparent 70%)`} aria-hidden="true"></div>
          <div class:list={['wrap grid items-start gap-8 py-[clamp(3rem,2rem+4vw,6rem)] lg:gap-14', i % 2 ? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(28rem,1fr)] lg:[&>div:first-child]:order-2' : 'lg:grid-cols-[minmax(28rem,1fr)_minmax(0,1.15fr)]']}>
            <div class="min-w-0 lg:sticky lg:top-24">
              <div data-print>
                <p class="eyebrow"><span>{String(i + 1).padStart(2, '0')}</span> · {p.category}</p>
                <h3 id={`${p.slug}-title`} class="mt-3 text-sub font-semibold">{p.name}</h3>
                <p class="mt-3 text-lead text-fg/90">{p.tagline}</p>
                <p class="measure mt-2 text-mute">{p.description}</p>
                <ul data-lines class="mt-5 space-y-2.5 text-small text-fg/85" aria-label={`Puntos clave de ${p.name}`}>
                  {p.highlights.map((h) => (
                    <li class="flex gap-3"><svg class="mt-[.3rem] h-4 w-4 shrink-0 text-live" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5"/></svg><span>{h}</span></li>
                  ))}
                </ul>
                <ul data-lines class="mt-5 flex flex-wrap gap-1.5" aria-label={`Stack de ${p.name}`}>
                  {p.stack.map((s) => <li class="chip">{s}</li>)}
                </ul>
                {(p.repo || p.demo) && (
                  <div data-full class="mt-6 flex flex-wrap gap-3">
                    {p.demo && <a class="btn btn-primary" href={p.demo} rel="noopener">Probar demo <span aria-hidden="true">↗</span></a>}
                    {p.repo && <a class="btn btn-ghost" href={p.repo} rel="noopener">Ver código <span aria-hidden="true">↗</span></a>}
                  </div>
                )}
              </div>
              <Arch stack={p.stack} />
            </div>
            <div class="min-w-0">
              <Frame id={p.slug} title={p.name} shots={p.shots!} device={p.device} assemble />
            </div>
          </div>
        </article>
      ))}
    </section>

    <!-- ───────────── Más sistemas ───────────── -->
    <section id="sistemas" class="mt-section border-t border-line bg-bg2" data-narr={`scan sistemas… ${others.length} encontrados`} aria-labelledby="sistemas-title">
      <div class="wrap py-section">
        <div data-print class="max-w-3xl">
          <p class="eyebrow">Más sistemas</p>
          <h2 id="sistemas-title" class="mt-3 text-title font-semibold">Donde pesa la arquitectura.</h2>
          <p class="measure mt-4 text-lead text-mute">Stack y decisiones clave.</p>
        </div>

        <div data-lines class="filters mt-8 sm:mt-10" role="group" aria-label="Filtrar por área">
          <button type="button" class="filter" data-filter="Todos" aria-pressed="true">Todos<span class="count">{others.length}</span></button>
          {categories.map((c) => (
            <button type="button" class="filter" data-filter={c} aria-pressed="false">{c}<span class="count">{countBy(c)}</span></button>
          ))}
        </div>
        <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>

        <ul class="mt-6 grid gap-4 sm:mt-8 md:grid-cols-2 md:gap-5" id="sys-list">
          {others.map((p, i) => (
            <li class="sys" data-cat={p.category} data-wipe style={`--dl:${(i % 4) * 70}ms`}>
              <article class="card" data-featured={p.featured ? 'true' : 'false'}>
                <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
                  <div class="flex items-center justify-between gap-3">
                    <p class="flex items-center gap-2 font-mono text-micro text-mute">
                      <span class="h-2 w-2 shrink-0 rounded-full" style={`background:${catColor[p.category] ?? '#8b9bff'}`} aria-hidden="true"></span>{p.category}
                    </p>
                    {p.featured && <span class="rounded-full border border-accent/40 bg-accent/10 px-2.5 py-0.5 text-micro font-medium text-accent">Destacado</span>}
                  </div>
                  <div>
                    <h3 class="text-xl font-semibold tracking-tight">{p.name}</h3>
                    <p class="mt-1.5 text-fg/90">{p.tagline}</p>
                  </div>
                  <ul class="flex flex-wrap gap-1.5" aria-label={`Stack de ${p.name}`}>
                    {p.stack.map((s) => <li class="chip">{s}</li>)}
                  </ul>
                  <details class="more mt-auto border-t border-line">
                    <summary>Puntos clave <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6"/></svg></summary>
                    <ul class="space-y-2 pb-2 pt-1 text-small text-fg/85">
                      {p.highlights.map((h) => (
                        <li class="flex gap-2.5"><svg class="mt-[.28rem] h-4 w-4 shrink-0 text-live" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 8.5l3 3L12.5 4.5"/></svg><span>{h}</span></li>
                      ))}
                    </ul>
                  </details>
                  {(p.repo || p.demo) && (
                    <div class="-mt-1 flex gap-6">
                      {p.repo && <a class="link text-small" href={p.repo} rel="noopener">Código <span aria-hidden="true">↗</span><span class="sr-only"> de {p.name}</span></a>}
                      {p.demo && <a class="link text-small" href={p.demo} rel="noopener">Demo <span aria-hidden="true">↗</span><span class="sr-only"> de {p.name}</span></a>}
                    </div>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────────── Servicios ───────────── -->
    <section id="servicios" class="border-t border-line" data-narr="build servicios… ok" aria-labelledby="servicios-title">
      <div class="wrap py-section">
        <div data-print class="max-w-3xl">
          <p class="eyebrow">Servicios</p>
          <h2 id="servicios-title" class="mt-3 text-title font-semibold">Qué puedo hacer por ti.</h2>
        </div>
        <ul class="mt-8 grid gap-px sm:mt-12 overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
          {profile.offers.map((o, i) => (
            <li class="group bg-bg p-5 transition-colors sm:p-7 hover:bg-panel" data-wipe style={`--dl:${i * 80}ms`}>
              <p class="font-mono text-micro text-accent" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 text-lg font-semibold tracking-tight sm:mt-6">{o.t}</h3>
              <p class="mt-1 text-small text-mute sm:mt-2">{o.d}</p>
            </li>
          ))}
        </ul>
        <div class="mt-10 sm:mt-12">
          <h3 class="text-small font-medium text-mute">Tecnologías</h3>
          <ul data-lines class="mt-4 flex flex-wrap gap-2">
            {topTech.map((t) => <li class="chip !rounded-full !px-3 !py-1">{t}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ───────────── Contacto ───────────── -->
    <section id="contacto" class="border-t border-line" data-narr="open canal contacto… listo" aria-labelledby="contacto-title">
      <div class="wrap py-section">
        <div data-wipe class="clip rounded-3xl border border-line2 bg-panel/60 px-[clamp(1.25rem,0.5rem+4vw,5rem)] py-[clamp(2.5rem,1.5rem+5vw,6rem)]" style="--wd:.85s">
          <div class="glow" style="background: radial-gradient(60% 80% at 50% 110%, rgb(139 155 255 / .3), transparent 70%)" aria-hidden="true"></div>
          <div class="grid-bg" aria-hidden="true"></div>
          <div class="grid items-center gap-8 md:grid-cols-12 md:gap-10">
            <div class="md:col-span-6">
              <p class="eyebrow">Contacto</p>
              <h2 id="contacto-title" class="mt-3 text-title font-semibold">Hablemos<span class="text-accent">.</span></h2>
              <p class="mt-4 text-lead text-mute">{profile.availability}.</p>
            </div>
            <div data-lines class="grid gap-3 md:col-span-6" style="--base:280ms">
              <ContactLink a={wa} showHint class="btn btn-primary !min-h-14 !justify-start !gap-3 !px-5 !text-base" />
              <div class="contact-grid grid grid-cols-2 gap-3">
                {secondary.map((a) => <ContactLink a={a} class="btn btn-ghost !min-h-14 !justify-start !gap-3 !px-4" />)}
              </div>
              <p class="mt-2 flex flex-wrap gap-x-5 text-small">
                <a class="link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a>
                <a class="link" href={profile.motion} rel="noopener">Motion y diseño <span aria-hidden="true">↗</span></a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer id="footer" class="site-footer border-t border-line bg-bg2">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5 text-small text-mute">
      <p><span class="font-semibold tracking-tight text-fg">{profile.name}<span class="text-accent">.dev</span></span> · © {new Date().getFullYear()}</p>
      <div class="flex items-center gap-5">
        <a class="link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a>
        <a class="link" href="#top">Volver arriba <span aria-hidden="true">↑</span></a>
      </div>
    </div>
  </footer>

  <!-- Barra de contacto móvil -->
  <div class="dock" id="dock" aria-label="Contacto rápido" role="group">
    <ContactLink a={wa} class="btn btn-primary !min-h-12 flex-1" />
    <ContactLink a={call} class="btn btn-ghost !min-h-12 flex-1" />
  </div>

  <script>
    // Menú móvil
    const header = document.getElementById('site-header')!;
    const nav = document.getElementById('site-nav')!;
    const btn = document.getElementById('menu-btn') as HTMLButtonElement;
    const label = document.getElementById('menu-label')!;
    const setMenu = (open: boolean) => {
      nav.classList.toggle('menu-open', open);
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Cerrar' : 'Menú';
      btn.querySelector('.m-open')!.classList.toggle('hidden', open);
      btn.querySelector('.m-close')!.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
    nav.querySelectorAll('#nav-panel a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setMenu(false); btn.focus(); } });

    // Barra de contacto móvil: aparece al pasar el CTA del hero y se oculta en contacto/pie
    const dock = document.getElementById('dock')!;
    const state = { past: false, contact: false };
    const sync = () => {
      const show = state.past && !state.contact;
      dock.dataset.show = String(show);
      dock.toggleAttribute('inert', !show);
    };
    sync();
    if ('IntersectionObserver' in window) {
      const heroCta = document.getElementById('hero-cta')!;
      new IntersectionObserver(([e]) => { state.past = !e.isIntersecting && e.boundingClientRect.top < 0; sync(); }).observe(heroCta);
      const seen = new Set<Element>();
      const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target))); state.contact = seen.size > 0; sync(); });
      ['contacto', 'footer'].forEach((id) => io.observe(document.getElementById(id)!));
    }

    // Cabecera con borde al hacer scroll
    const onScroll = () => header.classList.toggle('header-scrolled', window.scrollY > 8);
    onScroll(); addEventListener('scroll', onScroll, { passive: true });

    // Sección activa en la navegación
    const links = new Map<string, HTMLAnchorElement>();
    document.querySelectorAll<HTMLAnchorElement>('#nav-panel a[href^="#"]').forEach((a) => links.set(a.getAttribute('href')!.slice(1), a));
    if ('IntersectionObserver' in window) {
      const spy = new IntersectionObserver((es) => es.forEach((e) => {
        const a = links.get(e.target.id);
        if (!a) return;
        if (e.isIntersecting) { links.forEach((l) => l.removeAttribute('aria-current')); a.setAttribute('aria-current', 'true'); }
        else a.removeAttribute('aria-current');
      }), { rootMargin: '-45% 0px -50% 0px' });
      links.forEach((_, id) => { const s = document.getElementById(id); if (s) spy.observe(s); });
    }

    // Filtro de sistemas
    const fb = document.querySelectorAll<HTMLButtonElement>('.filter');
    const sys = document.querySelectorAll<HTMLElement>('.sys');
    const status = document.getElementById('filter-status')!;
    fb.forEach((b) => b.addEventListener('click', () => {
      fb.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let n = 0;
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      sys.forEach((s) => {
        const show = b.dataset.filter === 'Todos' || s.dataset.cat === b.dataset.filter;
        s.hidden = !show;
        s.classList.remove('pop');
        if (show) {
          s.classList.add('is-in');
          if (!calm) { void s.offsetWidth; s.style.setProperty('--k', String(Math.min(n, 8))); s.classList.add('pop'); }
          n++;
        }
      });
      status.textContent = `Mostrando ${n} ${n === 1 ? 'sistema' : 'sistemas'}${b.dataset.filter === 'Todos' ? '' : ` en ${b.dataset.filter}`}`;
    }));
  </script>
</Base>
