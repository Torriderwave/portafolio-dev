---
// Marco de navegador o teléfono con capturas intercambiables (tabs accesibles).
// Sin JS: todas las capturas se muestran apiladas, cada una con su leyenda.
interface Props {
  id: string;
  shots: { src: string; label: string }[];
  device?: 'browser' | 'phone';
  title: string;
  /** Primera captura: eager + fetchpriority=high (solo para la imagen LCP). */
  priority?: boolean;
  /** Atributo sizes para el srcset de las capturas de 1800px. */
  sizes?: string;
  /** Ensambla el marco: wireframe y luego wipe de la captura. */
  assemble?: boolean;
}
const { id, shots, device = 'browser', title, priority = false, sizes = '(min-width: 1024px) 600px, 100vw', assemble = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isPhone = device === 'phone';
const dims = isPhone ? { w: 560, h: 1212 } : { w: 1800, h: 1126 };
const srcset = (f: string) => [800, 1200].map((w) => `${base}/projects/${f.replace('.webp', `-${w}.webp`)} ${w}w`).concat(`${base}/projects/${f} 1800w`).join(', ');
const host = title.toLowerCase().replace(/\s+/g, '-');
---
<div class:list={['frame', isPhone && 'mx-auto w-full max-w-[17rem]']} data-frame={id} data-assemble={assemble ? '' : undefined}>
  {assemble && (isPhone ? (
    <svg class="wire" viewBox="0 0 120 220" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <rect class="w-a" pathLength="1" x="2" y="2" width="116" height="216" rx="16" style="--k:0" />
      <rect pathLength="1" x="28" y="10" width="64" height="6" rx="3" style="--k:1" />
      <rect pathLength="1" x="12" y="28" width="96" height="54" rx="4" style="--k:2" />
      <path pathLength="1" d="M16 96H104M16 108H88M16 120H96" style="--k:3" />
      <rect pathLength="1" x="12" y="140" width="96" height="36" rx="4" style="--k:4" />
      <rect pathLength="1" x="36" y="196" width="48" height="8" rx="4" style="--k:5" />
    </svg>
  ) : (
    <svg class="wire" viewBox="0 0 400 250" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <rect class="w-a" pathLength="1" x="1.5" y="1.5" width="397" height="247" rx="12" style="--k:0" />
      <path pathLength="1" d="M1.5 36H398.5" style="--k:1" />
      <circle pathLength="1" cx="20" cy="18" r="4" style="--k:2" />
      <circle pathLength="1" cx="34" cy="18" r="4" style="--k:2" />
      <circle pathLength="1" cx="48" cy="18" r="4" style="--k:2" />
      <rect pathLength="1" x="130" y="11" width="140" height="14" rx="4" style="--k:3" />
      <rect pathLength="1" x="16" y="50" width="92" height="184" rx="6" style="--k:4" />
      <rect pathLength="1" x="120" y="50" width="264" height="86" rx="6" style="--k:5" />
      <path pathLength="1" d="M132 154H372M132 170H320M132 186H348" style="--k:6" />
      <rect pathLength="1" x="120" y="204" width="78" height="22" rx="6" style="--k:7" />
    </svg>
  ))}
  <div class:list={['device', isPhone && '!rounded-[2.4rem] !border-line2 !bg-black p-2.5']}>
    {!isPhone && (
      <div class="device-bar">
        <div class="flex gap-1.5" aria-hidden="true"><i class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></i><i class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></i><i class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></i></div>
        <div class="mx-auto min-w-0 max-w-xs flex-1 truncate rounded-md bg-bg px-3 py-1 text-center font-mono text-micro text-mute" aria-hidden="true">localhost / {host}</div>
        <div class="w-10 shrink-0" aria-hidden="true"></div>
      </div>
    )}
    {!isPhone && shots.length > 1 && (
      <div class="tabs js-only" role="tablist" aria-label={`Pantallas de ${title}`}>
        {shots.map((s, i) => (
          <button type="button" role="tab" id={`${id}-tab-${i}`} aria-controls={`${id}-panel-${i}`} aria-selected={i === 0} tabindex={i === 0 ? 0 : -1} class="tab">{s.label}</button>
        ))}
      </div>
    )}
    <div class:list={['stage', isPhone && 'overflow-hidden rounded-[1.9rem]']}>
      {shots.map((s, i) => (
        <div role={shots.length > 1 && !isPhone ? 'tabpanel' : undefined} id={`${id}-panel-${i}`} aria-labelledby={shots.length > 1 && !isPhone ? `${id}-tab-${i}` : undefined} data-active={i === 0} class="panel">
          <figure class="m-0">
          <img
            src={`${base}/projects/${s.src}`}
            srcset={isPhone ? undefined : srcset(s.src)}
            sizes={isPhone ? undefined : sizes}
            alt={`${title}: ${s.label}`}
            width={dims.w} height={dims.h}
            loading={priority && i === 0 ? 'eager' : 'lazy'}
            fetchpriority={priority && i === 0 ? 'high' : undefined}
            decoding="async"
            class:list={['block h-auto w-full bg-white', isPhone && 'aspect-[390/844] object-cover object-top']}
          />
          {!isPhone && (
            <figcaption class="caption">
              <span>{s.label}</span>
              {shots.length > 1 && <span class="font-mono" aria-hidden="true">{String(i + 1).padStart(2, '0')} / {String(shots.length).padStart(2, '0')}</span>}
            </figcaption>
          )}
          </figure>
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-frame]').forEach((f) => {
    const tabs = Array.from(f.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(f.querySelectorAll<HTMLElement>('.panel'));
    if (tabs.length < 2) return;
    const go = (n: number, focus = false, user = true) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === n)); t.tabIndex = k === n ? 0 : -1; });
      panels.forEach((p, k) => {
        p.dataset.active = String(k === n);
        p.toggleAttribute('inert', k !== n);
        p.style.setProperty('--x', k === n ? '0%' : k < n ? '-3%' : '3%'); // desliza en la dirección del cambio
      });
      if (user) tabs[n].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (focus) tabs[n].focus();
    };
    go(0, false, false);
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => go(k));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = e.key === 'ArrowRight' ? (k === last ? 0 : k + 1)
          : e.key === 'ArrowLeft' ? (k === 0 ? last : k - 1)
          : e.key === 'Home' ? 0 : e.key === 'End' ? last : -1;
        if (next >= 0) { e.preventDefault(); go(next, true); }
      });
    });
  });
</script>
