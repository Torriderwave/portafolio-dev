---
// Marco de navegador o teléfono con capturas intercambiables (tabs).
interface Props { id: string; shots: { src: string; label: string }[]; device?: 'browser' | 'phone'; title: string; }
const { id, shots, device = 'browser', title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{device === 'phone' ? (
  <div class="mx-auto w-[260px] rounded-[2.4rem] border border-line bg-black p-2.5 shadow-2xl shadow-black/60">
    <div class="overflow-hidden rounded-[1.9rem] bg-white">
      <img src={`${base}/projects/${shots[0].src}`} alt={`${title}: ${shots[0].label}`} loading="lazy" class="block aspect-[390/844] w-full object-cover object-top" />
    </div>
  </div>
) : (
  <div class="frame overflow-hidden rounded-xl border border-line bg-panel shadow-2xl shadow-black/60" data-frame={id}>
    <div class="flex items-center gap-3 border-b border-line bg-bg2 px-3 py-2">
      <div class="flex gap-1.5" aria-hidden="true"><i class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></i><i class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></i><i class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></i></div>
      <div class="mx-auto max-w-xs flex-1 truncate rounded-md bg-bg px-3 py-1 text-center font-mono text-[11px] text-mute">localhost / {title.toLowerCase().replace(/\s+/g, '-')}</div>
      <div class="w-10"></div>
    </div>
    <div class="relative aspect-[16/10] bg-white">
      {shots.map((s, i) => (
        <img src={`${base}/projects/${s.src}`} alt={`${title}: ${s.label}`} loading={i === 0 ? 'eager' : 'lazy'} data-shot={i} class:list={['shot absolute inset-0 h-full w-full object-cover object-top', i === 0 ? 'opacity-100' : 'opacity-0']} />
      ))}
    </div>
    {shots.length > 1 && (
      <div class="flex gap-1 border-t border-line bg-bg2 p-1.5" role="tablist" aria-label={`Pantallas de ${title}`}>
        {shots.map((s, i) => (
          <button type="button" role="tab" aria-selected={i === 0} data-tab={i} class="tab flex-1 rounded-md px-3 py-1.5 text-sm text-mute transition hover:text-fg aria-selected:bg-panel aria-selected:text-fg">{s.label}</button>
        ))}
      </div>
    )}
  </div>
)}
